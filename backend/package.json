{
  "name": "botica-backend",
  "version": "1.0.0",
  "description": "Sistema de inventario y vencimientos para boticas - backend",
  "scripts": {
    "start": "node src/servidor.js",
    "start:dev": "node --watch src/servidor.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:e2e": "npm test -- --config ./test/jest-e2e.json",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*.spec.js$",
    "transform": {},
    "testEnvironment": "node"
  },
  "license": "ISC",
  "devDependencies": {
    "jest": "^30.5.2",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "type": "module",
  "main": "src/servidor.js"
}
