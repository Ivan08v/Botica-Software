// Sistema de inventario y vencimientos para boticas y veterinarias
// Varios negocios comparten la misma base: cada fila lleva su negocio_id
// y la API filtra siempre por el negocio del usuario que inició sesión.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  DUENO
  VENDEDOR
}

enum TipoNegocio {
  BOTICA
  VETERINARIA
}

enum TipoMovimiento {
  INGRESO // compra de mercadería (entra un lote)
  VENTA // sale producto por una venta
  AJUSTE // corrección de inventario (conteo físico)
  BAJA_VENCIMIENTO // se retira un lote vencido
}

enum TipoDocumento {
  DNI // 8 dígitos
  CE // carné de extranjería, 9 a 12 caracteres
  RUC // 11 dígitos: empresas y personas con negocio; necesario para una factura
}

// Tipo de comprobante que se entrega. El sistema lo registra y numera, pero no lo
// envía a SUNAT: no reemplaza a la facturación electrónica.
enum TipoComprobante {
  BOLETA
  FACTURA
}

enum MedioPago {
  EFECTIVO
  TARJETA
  YAPE
  PLIN
  TRANSFERENCIA // ya no se acepta en ventas nuevas; se conserva por las ventas antiguas
}

// Cada botica o veterinaria que usa el sistema
model Negocio {
  id          Int          @id @default(autoincrement())
  nombre      String
  tipo        TipoNegocio  @default(BOTICA)
  activo      Boolean      @default(true)
  creadoEn    DateTime     @default(now()) @map("creado_en")
  usuarios    Usuario[]
  productos   Producto[]
  lotes       Lote[]
  ventas      Venta[]
  movimientos Movimiento[]
  clientes    Cliente[]

  @@map("negocios")
}

model Usuario {
  id           Int          @id @default(autoincrement())
  negocioId    Int          @map("negocio_id")
  negocio      Negocio      @relation(fields: [negocioId], references: [id])
  nombre       String
  // Único en todo el sistema: con el correo se sabe a qué negocio entra la persona
  correo       String       @unique
  passwordHash String       @map("password_hash")
  rol          Rol          @default(VENDEDOR)
  activo       Boolean      @default(true)
  creadoEn     DateTime     @default(now()) @map("creado_en")
  ventas       Venta[]
  movimientos  Movimiento[]

  @@index([negocioId])
  @@map("usuarios")
}

model Producto {
  id           Int            @id @default(autoincrement())
  negocioId    Int            @map("negocio_id")
  negocio      Negocio        @relation(fields: [negocioId], references: [id])
  nombre       String // ej. "Paracetamol 500 mg"
  laboratorio  String?
  presentacion String? // ej. "Caja x 100 tabletas"
  codigoBarras String?        @map("codigo_barras")
  precioVenta  Decimal        @map("precio_venta") @db.Decimal(10, 2)
  stockMinimo  Int            @default(0) @map("stock_minimo")
  activo       Boolean        @default(true)
  creadoEn     DateTime       @default(now()) @map("creado_en")
  lotes        Lote[]
  detalles     DetalleVenta[]
  movimientos  Movimiento[]

  // Único por negocio: dos boticas venden el mismo producto con el mismo código
  @@unique([negocioId, codigoBarras])
  @@index([negocioId, nombre])
  @@map("productos")
}

model Lote {
  id                Int            @id @default(autoincrement())
  negocioId         Int            @map("negocio_id")
  negocio           Negocio        @relation(fields: [negocioId], references: [id])
  productoId        Int            @map("producto_id")
  producto          Producto       @relation(fields: [productoId], references: [id])
  numeroLote        String         @map("numero_lote")
  fechaVencimiento  DateTime       @map("fecha_vencimiento") @db.Date
  cantidadInicial   Int            @map("cantidad_inicial")
  // La base exige cantidad_actual >= 0 (CHECK creado en la migración check_stock_no_negativo)
  cantidadActual    Int            @map("cantidad_actual")
  costoUnitario     Decimal        @map("costo_unitario") @db.Decimal(10, 2)
  fechaIngreso      DateTime       @default(now()) @map("fecha_ingreso")
  detalles          DetalleVenta[]
  movimientos       Movimiento[]

  @@unique([productoId, numeroLote])
  // FEFO: buscar rápido los lotes de un producto ordenados por vencimiento
  @@index([productoId, fechaVencimiento])
  // Panel: "¿qué vence en los próximos N días en mi negocio?"
  @@index([negocioId, fechaVencimiento])
  @@map("lotes")
}

// Cliente de la botica, identificado por su DNI, carné de extranjería o RUC dentro del negocio.
// Registrarlo es opcional en una boleta (salvo montos altos) y obligatorio en una factura.
model Cliente {
  id            Int           @id @default(autoincrement())
  negocioId     Int           @map("negocio_id")
  negocio       Negocio       @relation(fields: [negocioId], references: [id])
  tipoDocumento TipoDocumento @default(DNI) @map("tipo_documento")
  documento     String
  nombre        String // nombre completo o, si es RUC de empresa, la razón social
  telefono      String?
  email         String?
  direccion     String? // dirección fiscal, para la factura
  creadoEn      DateTime      @default(now()) @map("creado_en")
  ventas        Venta[]

  // El mismo DNI puede ser cliente de dos boticas distintas
  @@unique([negocioId, documento])
  @@index([negocioId, nombre])
  @@map("clientes")
}

model Venta {
  id        Int            @id @default(autoincrement())
  negocioId Int            @map("negocio_id")
  negocio   Negocio        @relation(fields: [negocioId], references: [id])
  fecha     DateTime       @default(now())
  usuarioId Int            @map("usuario_id")
  usuario   Usuario        @relation(fields: [usuarioId], references: [id])
  // Opcional: la mayoría de ventas de mostrador son anónimas
  clienteId Int?           @map("cliente_id")
  // Restrict: la base no deja eliminar un cliente que tiene ventas
  cliente   Cliente?       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  total     Decimal        @db.Decimal(10, 2) // lo cobrado, con IGV incluido
  // total = opGravada + igv. Los precios ya incluyen el IGV: aquí queda separado lo que es
  // de la botica (opGravada) de lo que se paga a SUNAT (igv). Ver src/common/igv.ts
  opGravada Decimal?       @map("op_gravada") @db.Decimal(10, 2)
  igv       Decimal?       @db.Decimal(10, 2)
  detalles  DetalleVenta[]

  tipoComprobante TipoComprobante @default(BOLETA) @map("tipo_comprobante")
  // Serie y número correlativo por negocio: B001-00000001, F001-00000001...
  // Pueden ser nulos solo en ventas cargadas directo a la base (pruebas, datos antiguos).
  serie           String?
  numero          Int?
  medioPago       MedioPago       @default(EFECTIVO) @map("medio_pago")
  // Solo en efectivo: con cuánto pagó el cliente (el vuelto es la diferencia con el total)
  montoRecibido   Decimal?        @map("monto_recibido") @db.Decimal(10, 2)

  @@unique([negocioId, serie, numero])
  @@index([negocioId, fecha])
  @@index([clienteId, fecha])
  @@map("ventas")
}

// Una línea por cada lote usado: si una venta de 10 unidades
// sale de 2 lotes (FEFO), se guardan 2 detalles.
// No lleva negocio_id: siempre se llega a ella a través de su venta.
model DetalleVenta {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @map("venta_id")
  venta          Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoId     Int      @map("producto_id")
  producto       Producto @relation(fields: [productoId], references: [id])
  loteId         Int      @map("lote_id")
  lote           Lote     @relation(fields: [loteId], references: [id])
  cantidad       Int
  precioUnitario Decimal  @map("precio_unitario") @db.Decimal(10, 2)

  @@index([ventaId])
  @@map("detalle_venta")
}

// Historial de todo lo que cambia el stock (trazabilidad)
model Movimiento {
  id         Int            @id @default(autoincrement())
  negocioId  Int            @map("negocio_id")
  negocio    Negocio        @relation(fields: [negocioId], references: [id])
  tipo       TipoMovimiento
  productoId Int            @map("producto_id")
  producto   Producto       @relation(fields: [productoId], references: [id])
  loteId     Int            @map("lote_id")
  lote       Lote           @relation(fields: [loteId], references: [id])
  cantidad   Int // positivo entra, negativo sale
  usuarioId  Int            @map("usuario_id")
  usuario    Usuario        @relation(fields: [usuarioId], references: [id])
  motivo     String?
  fecha      DateTime       @default(now())

  @@index([negocioId, fecha])
  @@index([productoId, fecha])
  @@map("movimientos")
}
